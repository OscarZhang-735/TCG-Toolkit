API_DOMAIN=tcgtoolkit.rinne.love
TCG_PROXY_IPS=172.19.0.1
RAPIDAPI_KEY=

# Email verification: keep credentials and the HMAC secret on the server.
# starttls defaults to port 587; ssl defaults to 465 when PORT is empty.
TCG_SMTP_HOST=
TCG_SMTP_PORT=
TCG_SMTP_USERNAME=
TCG_SMTP_PASSWORD=
TCG_SMTP_FROM=
TCG_SMTP_TLS=starttls
TCG_EMAIL_CODE_SECRET=
TCG_SUBSCRIPTIONS_ENABLED=true
# Web UI address used by links in subscription emails; empty uses https://oscarzhang-735.github.io/TCG-Toolkit/.
TCG_SITE_URL=
# Linux containers read the host timezone through /etc/localtime (read-only).
# TCG_SMTP_FROM example: TCG Toolkit <noreply@example.com>
# TCG_EMAIL_CODE_SECRET: generate a stable random secret of at least 32 bytes.

# PostgreSQL: use distinct randomly generated passwords; keep this file private.
PGHOST=db
PGPORT=5432
PGDATABASE=tcg
PGUSER=tcg
PGPASSWORD=
TCG_PG_ADMIN_PASSWORD=
TCG_DB_SUBNET=10.205.0.0/24
# Pin the PostgreSQL image alongside the backend release; do not change major versions in place.
TCG_POSTGRES_IMAGE=postgres:17-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5
