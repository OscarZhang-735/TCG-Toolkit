# Local HTTP development only; production must use HTTPS.
TCG_PORT=8000
TCG_TRUSTED_ORIGINS=http://localhost:8000
TCG_USER_DB=data/users.sqlite3
# Exact trusted proxy source addresses. Never use * on an exposed service.
TCG_PROXY_IPS=127.0.0.1
RAPIDAPI_KEY=
# Search HTML forwarding API; set empty to explicitly use direct requests.
TCG_SEARCH_PROXY_URL=http://62.234.212.90:8080/proxy

# Local-only UI proxy toggle. Set false for online deployments.
TCG_ALLOW_PROXY_SWITCH=true

# Email verification: keep credentials and the HMAC secret on the server.
# starttls defaults to port 587; ssl defaults to 465 when PORT is empty.
TCG_SMTP_HOST=
TCG_SMTP_PORT=
TCG_SMTP_USERNAME=
TCG_SMTP_PASSWORD=
TCG_SMTP_FROM=
TCG_SMTP_TLS=starttls
TCG_EMAIL_CODE_SECRET=
# TCG_SMTP_FROM example: TCG Toolkit <noreply@example.com>
# TCG_EMAIL_CODE_SECRET: generate a stable random secret of at least 32 bytes.
