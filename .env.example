# Local HTTP development only; production must use HTTPS.
TCG_PORT=8000
TCG_TRUSTED_ORIGINS=http://localhost:8000
# Exact trusted proxy source addresses. Never use * on an exposed service.
TCG_PROXY_IPS=127.0.0.1
RAPIDAPI_KEY=
# Zyte Extract API for PSA and CGC certificate pages.
ZYTE_API_KEY=
# Search HTML forwarding API; set empty to explicitly use direct requests.
TCG_SEARCH_PROXY_URL=

# Optional standalone proxy-go client: base URL or full /v1/fetch endpoint.
# Python on host: http://127.0.0.1:18087/v1/fetch
# Docker Desktop to host: http://host.docker.internal:18087/v1/fetch
PROXY_GO_API=
PROXY_GO_API_KEY=

# Signed-out search requests allowed per IP per minute (one search sends one request per game/shop/page).
TCG_GUEST_SEARCH_LIMIT=30

# Local-only UI proxy toggle. Set false for online deployments.
TCG_ALLOW_PROXY_SWITCH=true

# Email verification: keep credentials and the HMAC secret on the server.
# starttls defaults to port 587; ssl defaults to 465 when PORT is empty.
TCG_SMTP_HOST=
TCG_SMTP_PORT=
TCG_SMTP_USERNAME=
TCG_SMTP_PASSWORD=
TCG_SMTP_FROM=
TCG_SMTP_TLS=starttls
TCG_EMAIL_CODE_SECRET=
TCG_SUBSCRIPTIONS_ENABLED=true
# Web UI address used by links in subscription emails (default: the public GitHub Pages site).
TCG_SITE_URL=http://localhost:8000
# Docker Desktop: set this to the host IANA timezone before starting Compose.
TZ=America/Toronto
# TCG_SMTP_FROM example: TCG Toolkit <noreply@example.com>
# TCG_EMAIL_CODE_SECRET: generate a stable random secret of at least 32 bytes.

# PostgreSQL: use distinct randomly generated passwords; keep this file private.
PGHOST=db
PGPORT=5432
PGDATABASE=tcg
PGUSER=tcg
PGPASSWORD=
TCG_PG_ADMIN_PASSWORD=
TCG_DB_SUBNET=10.205.0.0/24
# Pin the PostgreSQL image alongside the backend release; do not change major versions in place.
TCG_POSTGRES_IMAGE=postgres:17-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5

# Enable encrypted proxy transport; path to a 32-byte raw master key.
TCG_PROXY_KEY_FILE=

# Private COS origin for avatars and graded card photos: https://<bucket-appid>.cos.<region>.myqcloud.com
TCG_AVATAR_COS_URL=
# Backend credentials for GetObject, PutObject and DeleteObject under tcgtoolkit/avatars/ and tcgtoolkit/graded/.
TCG_COS_SECRET_ID=
TCG_COS_SECRET_KEY=
